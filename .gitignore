# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
node_modules/
.next/
.env.local
.env

# native app build script backups (should not be committed)
*.native-build-bak

# expo
/mobile/node_modules
/mobile/.expo
/mobile/dist
/mobile/.expo-check-export
/mobile/.vscode

# local editor/workspace
/.vscode

# local/generated reports
/scripts/audit-content-output.json

# large temporary content import artifacts
/docs/incoming/*.json
!/docs/incoming/.gitkeep
