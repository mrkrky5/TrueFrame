    "mobile:windows": "node scripts/run-mobile-windows.mjs",
    "mobile:check": "node scripts/check-mobile.mjs",
    "pack:mac": "node scripts/pack-mac-drop.mjs",
    "pack:mac:content": "node scripts/pack-mac-drop.mjs --content-only",
    "pack:mac:release": "node scripts/pack-mac-drop.mjs --mobile",
    "pack:mac:project": "node scripts/pack-mac-full.mjs",
    "content:build-index": "node scripts/build-card-index.mjs",
    "content:quality": "node scripts/content-quality-signals.mjs",
    "content:quality:report": "node scripts/content-quality-signals.mjs --report",
    "content:quality:audit": "node scripts/content-quality-audit.mjs",
    "content:cleanup:preview": "node scripts/content-mechanical-cleanup-preview.mjs",
