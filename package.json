{
  "name": "true-frame",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "mobile": "npm run start --prefix mobile",
    "mobile:sync": "node scripts/setup-mobile-links.mjs",
    "mobile:ios": "npm run ios --prefix mobile",
