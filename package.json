    "content:apply-icon": "node scripts/apply-app-icon.mjs",
    "validate:en-content": "node scripts/validate-en-content.js",
    "legal:preview": "npx --yes serve legal-site/public",
    "resize:screenshots": "node scripts/resize-app-store-screenshots.mjs",
    "compose:screenshots": "node scripts/compose-app-store-screenshots.mjs"
